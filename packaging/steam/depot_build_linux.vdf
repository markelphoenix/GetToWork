// SteamPipe depot build: the Linux + SteamOS (Steam Deck) depot of GottaGottaGottaGo: To Work We Go.
// content/linux/ holds the unpacked Linux archive: content/linux/GottaGottaGottaGo/GottaGottaGottaGo ...
// (unpack it with tar on Linux or macOS, so the programs stay executable).
// Players' install folder then gets GottaGottaGottaGo/..., so the launch option is GottaGottaGottaGo/GottaGottaGottaGo.
"DepotBuild"
{
	"DepotID" "<DEPOT_ID_LINUX>"
	"FileMapping"
	{
		// Relative to the app build's ContentRoot (../content/).
		"LocalPath" "linux/*"
		// Relative to the game's install folder.
		"DepotPath" "."
		"Recursive" "1"
	}
}
