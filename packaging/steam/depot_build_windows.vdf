// SteamPipe depot build: the Windows depot of GottaGottaGottaGo: To Work We Go.
// content/windows/ holds the unpacked Windows archive: content/windows/GottaGottaGottaGo/GottaGottaGottaGo.exe ...
// Players' install folder then gets GottaGottaGottaGo/..., so the launch option is GottaGottaGottaGo\GottaGottaGottaGo.exe.
"DepotBuild"
{
	"DepotID" "<DEPOT_ID_WIN>"
	"FileMapping"
	{
		// Relative to the app build's ContentRoot (../content/).
		"LocalPath" "windows/*"
		// Relative to the game's install folder.
		"DepotPath" "."
		"Recursive" "1"
	}
	"FileExclusion" "*.pdb"
}
